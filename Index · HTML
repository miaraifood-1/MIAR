<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>MIAR APPS</title>
<link rel="manifest" href="manifest.webmanifest" />
<meta name="theme-color" content="#c2185b" />
<style>
  :root{
    --rosa: #c2185b;
    --rosa-claro: #f8d7e6;
    --verde: #4a7c59;
    --verde-claro: #d7ecd9;
    --bg: #fff9fb;
    --texto: #2b2230;
  }
  *{box-sizing:border-box;}
  body{margin:0;font-family:-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--texto);height:100vh;overflow:hidden;}
  #app{display:flex;flex-direction:column;height:100vh;}
 
  header{
    display:flex;align-items:center;gap:12px;padding:12px 16px;
    background:linear-gradient(90deg,var(--rosa),#8e2455);color:white;
    box-shadow:0 2px 8px rgba(0,0,0,.15);z-index:5;
  }
  #menuBtn{background:none;border:none;color:white;font-size:24px;cursor:pointer;padding:4px 8px;border-radius:8px;}
  #menuBtn:hover{background:rgba(255,255,255,.15);}
  header h1{font-size:17px;margin:0;flex:1;font-weight:600;}
  #activeProjectLabel{font-size:13px;opacity:.9;}
 
  /* Overlay + drawer lateral (o que o Robson pediu: menu, não chips espalhados) */
  #overlay{
    position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:10;
    opacity:0;pointer-events:none;transition:opacity .2s;
  }
  #overlay.open{opacity:1;pointer-events:auto;}
 
  #drawer{
    position:fixed;top:0;left:0;bottom:0;width:280px;background:white;z-index:11;
    transform:translateX(-100%);transition:transform .25s ease;
    display:flex;flex-direction:column;box-shadow:2px 0 12px rgba(0,0,0,.2);
  }
  #drawer.open{transform:translateX(0);}
  #drawer .drawer-header{padding:20px 16px;background:var(--rosa-claro);border-bottom:1px solid #eee;}
  #drawer .drawer-header strong{color:var(--rosa);font-size:16px;}
  #projectList{list-style:none;margin:0;padding:8px;flex:1;overflow-y:auto;}
  #projectList li{
    padding:12px 14px;border-radius:10px;cursor:pointer;margin-bottom:4px;
    display:flex;align-items:center;justify-content:space-between;gap:8px;
  }
  #projectList li:hover{background:var(--rosa-claro);}
  #projectList li.active{background:var(--rosa);color:white;}
  #projectList li .del{opacity:.5;font-size:13px;padding:2px 6px;border-radius:6px;}
  #projectList li .del:hover{opacity:1;background:rgba(0,0,0,.15);}
  #newProjectBtn{
    margin:8px;padding:12px;border:2px dashed var(--verde);background:var(--verde-claro);
    color:var(--verde);border-radius:10px;cursor:pointer;font-weight:600;
  }
 
  main{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px;}
  .msg{max-width:75%;padding:10px 14px;border-radius:14px;line-height:1.4;font-size:14.5px;white-space:pre-wrap;}
  .msg.user{align-self:flex-end;background:var(--rosa);color:white;border-bottom-right-radius:4px;}
  .msg.assistant{align-self:flex-start;background:var(--verde-claro);color:#1e3a24;border-bottom-left-radius:4px;}
  .msg.system{align-self:center;background:#fff3cd;color:#7a5c00;font-size:13px;padding:8px 12px;}
  .empty-state{margin:auto;text-align:center;color:#999;padding:24px;}
 
  footer{padding:12px 16px;background:white;border-top:1px solid #eee;display:flex;gap:8px;align-items:flex-end;}
  #msgInput{
    flex:1;resize:none;border:1px solid #ddd;border-radius:14px;padding:10px 14px;
    font-size:14.5px;font-family:inherit;max-height:140px;min-height:42px;line-height:1.4;
  }
  #sendBtn{background:var(--rosa);color:white;border:none;border-radius:50%;width:42px;height:42px;font-size:18px;cursor:pointer;flex-shrink:0;}
  #sendBtn:disabled{opacity:.4;cursor:not-allowed;}
 
  #apiWarning{
    background:#fff3cd;color:#7a5c00;font-size:12.5px;padding:6px 16px;text-align:center;display:none;
  }
</style>
</head>
<body>
<div id="app">
  <header>
    <button id="menuBtn" aria-label="Menu">☰</button>
    <div>
      <h1>MIAR APPS</h1>
      <div id="activeProjectLabel">Selecione um projeto</div>
    </div>
  </header>
 
  <div id="apiWarning">Sem chave de IA configurada no servidor ainda — projetos e conversas funcionam de verdade, mas a resposta da IA vai retornar aviso até a chave ser configurada.</div>
 
  <main id="chatArea">
    <div class="empty-state">Abra o menu ☰ e escolha um projeto para começar.</div>
  </main>
 
  <footer>
    <textarea id="msgInput" placeholder="Escreva sua mensagem..." rows="1" disabled></textarea>
    <button id="sendBtn" disabled>➤</button>
  </footer>
</div>
 
<div id="overlay"></div>
<div id="drawer">
  <div class="drawer-header"><strong>Projetos</strong></div>
  <ul id="projectList"></ul>
  <button id="newProjectBtn">+ Novo projeto</button>
</div>
 
<script src="app.js"></script>
</body>
</html>
 
